                {"direction": "in", "pin":"j2:1"},
                {"direction": "in", "pin":"j2:5"},
                {"direction": "out","pin": "j16:1"},
                {"direction": "out","pin": "j16:5"}
            ]
        }, {
            "module_type": "pwm",
            "instances": [
                {"pin": "j15:1"}
            ]
        }, {
            "module_type": "encoder",
            "instances": [
                {"pin_A":"j3:0", "pin_B":"j3:1"},
                {"pin_A":"j3:2", "pin_B":"j3:4"},
                {"pin_A":"j3:5", "pin_B":"j3:6"}
            ]
        }, {
            "module_type": "stepgen",
            "instances": [
                {
                    "pins" : {
                        "stepgen_type": "step_dir",
                        "step_pin": "j7:0",
                        "dir_pin": "j7:1"
                    },
                    "soft_stop": true
                }
            ]
        }
    ]
