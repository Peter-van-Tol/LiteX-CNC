{
    "name": "full_5a-75a",
    "board" : {
        "family": "colorlight",
        "board_type": "5A-75B",
        "revision": "8.0",
        "clock_frequency": 50000000,
        "connection": {
            "connection_type": "etherbone",
            "tx_delay": 0,
            "ip_address": "192.168.0.50",
            "mac_address": "0x10e2d5000000"
        }
    },
    "watchdog": {
        "pin":"j2:0"
    },
    "modules": [
        {
            "module_type": "gpio",
